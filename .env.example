# ============================================================
# 零次元动漫社抽奖机 · 环境变量示例
#
# 本地开发：复制本文件为 .env（netlify dev 会自动加载）
# 部署上线：在 Netlify 控制台
#   Site configuration → Environment variables 中配置同样的键
# ============================================================

# ---- 管理员密码（二选一，推荐使用哈希）----
# 生成哈希：node scripts/hash-password.js "你的密码"
ADMIN_PASSWORD_HASH=scrypt$16384$8$1$REPLACE_WITH_SALT$REPLACE_WITH_HASH
# 本地开发便捷方式（明文，函数启动时自动哈希；生产环境请勿使用）
# ADMIN_PASSWORD=your-password-here

# 忘记密码时的紧急重置：设置为 1 并部署新的 ADMIN_PASSWORD_HASH，
# 下次函数启动会应用新哈希并使所有旧会话失效（用后请改回 0）
ADMIN_PASSWORD_OVERRIDE=0

# ---- 会话 ----
# 管理员会话有效期（小时）
SESSION_TTL_HOURS=12

# ---- 抽奖防护 ----
# 同一用户两次抽奖的最小间隔（毫秒），防止脚本连点刷奖
DRAW_MIN_INTERVAL_MS=800
# 中奖记录最多保留条数（超出后自动丢弃最旧记录）
MAX_WINNERS=500

# ---- 速率限制（令牌桶，按 IP 维度计数） ----
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW=900
RATE_LIMIT_DRAW_MAX=30
RATE_LIMIT_DRAW_WINDOW=60
RATE_LIMIT_ADMIN_MAX=120
RATE_LIMIT_ADMIN_WINDOW=60
RATE_LIMIT_CHANGE_PW_MAX=3
RATE_LIMIT_CHANGE_PW_WINDOW=900

# ---- 存储 ----
# Netlify Blobs 的 store 名称（同一站点内唯一，一般无需修改）
BLOBS_STORE_NAME=zerodim-lottery
